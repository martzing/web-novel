# Server
PORT=8080
ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://mokchan:mokchan@localhost:5432/mokchan?sslmode=disable

# Auth. JWT_SECRET must be at least 16 characters; the API refuses to start otherwise.
JWT_SECRET=dev-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Password hashing (argon2id)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=2

# CORS
CORS_ORIGINS=http://localhost:5173

# Abuse control. TRUSTED_PROXIES is a CSV of proxy CIDRs; leave empty to trust
# none, which is what keeps X-Forwarded-For from defeating the per-IP limiter.
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MIN=60
BODY_FETCH_PER_MIN=20
TRUSTED_PROXIES=

# Coins
PAYMENTS_MOCK_ENABLED=true
BONUS_TTL=720h
PLATFORM_FEE_PERCENT=30

# Writer cover uploads
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE=/uploads

# Background jobs. Defaults to true outside production so `docker compose up`
# is a complete system; run cmd/worker separately when scaling the API.
RUN_JOBS_IN_API=true

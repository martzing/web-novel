{
    "name": "mokchan-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview --host",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.101.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.2"
    },
    "engines": {
        "node": ">=24.9.0"
    },
    "overrides": {
        "vite": "$vite"
    },
    "devDependencies": {
        "@testing-library/react": "^14.3.1",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.2",
        "jsdom": "^22.1.0",
        "typescript": "^5.5.4",
        "vite": "^4.5.5",
        "vitest": "^0.34.6"
